# ==============================================================
# LADANG KITA - VARIABEL LINGKUNGAN
# ==============================================================
# CATATAN PRIVASI & KEAMANAN:
# - Data pengguna (nama, email, hash password, alamat) disimpan di server (database MySQL).
# - Tidak ada data kartu kredit/debit atau rekening bank yang pernah disimpan di server kami.
#   Seluruh pemrosesan pembayaran ditangani langsung oleh Midtrans Snap.
# - Jangan pernah melakukan komit terhadap file .env atau .env.local ke repositori publik!
# ==============================================================

# Database MySQL/MariaDB
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ladang_kita
DATABASE_SSL=false

# Rahasia HMAC OTP (Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OTP_SECRET=

# Mailer: 'console' (demo/lokal) atau 'smtp' (production)
MAIL_DRIVER=console
MAIL_FROM=no-reply@ladangkita.local
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# URL Website
NEXT_PUBLIC_SITE_URL=http://localhost:3000
